# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me

# --- Database (MySQL) ---
# On Railway, add a MySQL service and reference its connection string instead of the five
# settings below: DATABASE_URL=${{MySQL.MYSQL_URL}}. A bare mysql:// scheme is rewritten to
# mysql+pymysql:// automatically, and it takes precedence when set.
# DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_exam_platform
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123

# --- JWT ---
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000

# --- CORS ---
# Comma-separated. In production this must list the Vercel origin (scheme + host, no path
# and no trailing slash), e.g. CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- NVIDIA NIM ---
NVIDIA_NIM_API_KEY=
# Optional separate key for the image model; leave blank to use NVIDIA_NIM_API_KEY.
NVIDIA_NIM_VISION_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Writes exams from PDF text.
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
# Read image materials and write the exam from them directly, ~35-45s a page. The fallback
# is tried only when the first model fails on a page.
NVIDIA_NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_VISION_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Reads pages the fast models above cannot. Measured on a Sinhala page: llama returned Tamil
# letters, nemotron returned Sinhala-shaped gibberish, this one transcribed it correctly - so
# Sinhala is read here instead. Slow (~6min a page), used only for languages the fast models
# are not trusted with. Blank it to use the fast models for every language.
NVIDIA_NIM_VISION_MULTILINGUAL_MODEL=moonshotai/kimi-k3

# --- File storage ---
MAX_CONTENT_LENGTH_MB=25

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gunicorn (production only; see gunicorn.conf.py) ---
# PORT is supplied by Railway. These only need setting to override the defaults.
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=120
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
